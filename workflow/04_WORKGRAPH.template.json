{
  "version": "1.0",
  "principles": [
    "Freeze interface contracts early to enable parallelism",
    "Assign file ownership to prevent merge conflicts",
    "Integration is an explicit task"
  ],
  "tasks": [
    {
      "id": "WG-01",
      "title": "Define interface contracts",
      "type": "spec",
      "depends_on": [],
      "owner_agent": "planner",
      "allowed_paths": [
        "docs/",
        "packages/shared-types/",
        "contracts/specs/"
      ],
      "deliverables": [
        "OpenAPI/typed API contract",
        "ABI/IDL client generation plan",
        "Shared types package"
      ],
      "verification": [
        "Schema/typecheck passes"
      ],
      "acceptance_tests": [
        "AT-API-CONTRACT-01",
        "AT-IDL-01"
      ]
    },
    {
      "id": "WG-02",
      "title": "Bootstrap deterministic local test harness",
      "type": "infra",
      "depends_on": [
        "WG-01"
      ],
      "owner_agent": "builder",
      "allowed_paths": [
        "scripts/",
        "docker/",
        "chain/",
        "backend/"
      ],
      "deliverables": [
        "One-command bootstrap that seeds wallets + state"
      ],
      "verification": [
        "bootstrap script runs twice with same result"
      ],
      "acceptance_tests": [
        "AT-BOOTSTRAP-01"
      ]
    }
  ]
}