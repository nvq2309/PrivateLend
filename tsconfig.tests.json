    "types": ["mocha", "chai"],
    "typeRoots": ["./node_modules/@types", "./tests/types"],
    "lib": ["es2022", "dom"],
    "module": "commonjs",
    "target": "es6",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
